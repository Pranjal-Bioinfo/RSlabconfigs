params {
    config_profile_description = 'RSlabconfigs cluster profile provided by nf-core/configs.'
    config_profile_contact = 'Pranjal (https://github.com/Pranjal-Bioinfo)'
}

process {
    executor = 'slurm'
    queue = 'compute'
    
    // Correct: Use single beforeScript with compound command
    beforeScript = 'module avail singularity; module load singularity-3.7.4 || true'
    
    // Removed: maxForks is deprecated and can cause hanging issues
    // Use executor.queueSize instead to control parallelism
    
    resourceLimits {
        cpus = 40
        memory = 350.GB
        time = 720.h
    }
}

executor {
    queueSize = 100  // Controls max concurrent jobs across all processes
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = '/lustre/samiksha.m/wastewater/singularity_cache'
}
