params {
    config_profile_description = 'RSlabconfigs cluster profile provided by nf-core/configs.'
    config_profile_contact     = 'Pranjal (https://github.com/Pranjal-Bioinfo)'
}

process {
    executor       = 'slurm'
    queue          = 'compute'
    beforeScript   = 'module avail singularity; module load singularity-3.7.4 || true'
    clusterOptions = '--exclude=node18,node30'
    
    resourceLimits {
        cpus   = 40
        memory = 350.GB
    }
}

executor {
    queueSize       = 10
    submitRateLimit = '10 sec'
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/lustre/saraswati/singularity'
    runOptions = '--cleanenv'
}
