params {
    config_profile_description = 'RSlabconfigs cluster profile provided by nf-core/configs.'
    config_profile_contact = 'Pranjal (https://github.com/Pranjal-Bioinfo)'
}

process {
    executor = 'slurm'
    queue = 'compute'
    
    // Load singularity module
    beforeScript = 'module avail singularity; module load singularity-3.7.4 || true'
    
    // Exclude faulty nodes (node2 and node16 are in drain state)
    clusterOptions = '--exclude=node2,node16,node17,node18,node23,node28,node31,node39'
    
    resourceLimits {
        cpus = 40
        memory = 350.GB
        time = 720.h
    }
}

executor {
    queueSize = 100  // Controls max concurrent jobs across all processes
    submitRateLimit = '10 sec'  // Prevents overwhelming SLURM scheduler
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = '/lustre/samiksha.m/wastewater/singularity_cache'
    runOptions = '--cleanenv'  // Prevents environment conflicts
}
